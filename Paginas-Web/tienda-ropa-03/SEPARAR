<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[NOMBRE DE LA TIENDA] — Plantilla</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#ECE8DE;
    --surface:#F6F4EC;
    --ink:#17140F;
    --stone:#8A8168;
    --line:#CBC3AC;
    --accent:#2B3EFF;
    --accent-ink:#FFFFFF;
    --danger:#B23A2E;
    --radius:2px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block; max-width:100%;}
  button{font-family:inherit; cursor:pointer; border:none; background:none;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}

  .mono{font-family:'JetBrains Mono', monospace;}
  .display{font-family:'Space Grotesk', sans-serif;}

  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:.68rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--stone);
  }

  .wrap{
    max-width:1280px;
    margin:0 auto;
    padding:0 clamp(1rem, 3vw, 2.5rem);
  }

  /* visible focus for accessibility */
  a:focus-visible, button:focus-visible, input:focus-visible{
    outline:2px solid var(--accent);
    outline-offset:2px;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.01ms !important; transition-duration:.01ms !important;}
  }

  /* ===== HEADER ===== */
  header.site-header{
    position:sticky; top:0; z-index:50;
    background:rgba(236,232,222,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .header-row{
    display:flex; align-items:center; justify-content:space-between;
    gap:1.5rem; padding:.9rem 0;
  }
  .logo{
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size:1.15rem;
    letter-spacing:-.01em;
  }
  .logo span{color:var(--accent);}
  nav.main-nav{display:flex; gap:1.8rem;}
  nav.main-nav a{
    font-size:.85rem; font-weight:500;
    letter-spacing:.02em;
    padding:.3rem 0;
    border-bottom:1px solid transparent;
    transition:border-color .15s ease, color .15s ease;
  }
  nav.main-nav a:hover, nav.main-nav a.active{border-bottom-color:var(--ink);}
  nav.main-nav a.offers{color:var(--danger);}

  .header-actions{display:flex; align-items:center; gap:.9rem;}
  .search-box{
    display:flex; align-items:center; gap:.4rem;
    border:1px solid var(--line);
    padding:.4rem .7rem;
    background:var(--surface);
    min-width:150px;
  }
  .search-box input{
    border:none; background:none; outline:none;
    font-family:'Inter'; font-size:.82rem; width:100%;
    color:var(--ink);
  }
  .search-box input::placeholder{color:var(--stone);}
  .icon-btn{
    position:relative;
    width:36px; height:36px;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--line);
    background:var(--surface);
  }
  .icon-btn svg{width:16px; height:16px; stroke:var(--ink);}
  .cart-count{
    position:absolute; top:-7px; right:-7px;
    background:var(--accent); color:var(--accent-ink);
    font-family:'JetBrains Mono'; font-size:.62rem;
    width:17px; height:17px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }
  .menu-toggle{display:none;}

  @media (max-width:840px){
    nav.main-nav{
      position:fixed; inset:0 0 0 auto; top:60px;
      width:min(78vw,300px); height:calc(100vh - 60px);
      background:var(--paper); border-left:1px solid var(--line);
      flex-direction:column; padding:1.5rem; gap:0;
      transform:translateX(100%); transition:transform .25s ease;
    }
    nav.main-nav.open{transform:translateX(0);}
    nav.main-nav a{padding:.85rem 0; border-bottom:1px solid var(--line); width:100%;}
    .search-box{display:none;}
    .menu-toggle{
      display:flex; width:36px; height:36px; align-items:center; justify-content:center;
      border:1px solid var(--line); background:var(--surface);
    }
    .menu-toggle svg{width:16px; height:16px;}
  }

  /* ===== HERO ===== */
  .hero{
    position:relative;
    margin:1rem clamp(1rem,3vw,2.5rem) 0;
    height:min(78vh, 620px);
    min-height:420px;
    border:1px solid var(--line);
    background:
      repeating-linear-gradient(45deg, #DCD6C4 0 2px, #E6E1D1 2px 26px);
    overflow:hidden;
  }
  .crop-corner{position:absolute; width:22px; height:22px; z-index:3;}
  .crop-corner::before,.crop-corner::after{content:"";position:absolute; background:var(--ink);}
  .crop-corner.tl{top:14px; left:14px;}
  .crop-corner.tr{top:14px; right:14px;}
  .crop-corner.bl{bottom:14px; left:14px;}
  .crop-corner.br{bottom:14px; right:14px;}
  .crop-corner::before{width:100%; height:1.5px; top:0; left:0;}
  .crop-corner::after{width:1.5px; height:100%; top:0; left:0;}
  .crop-corner.tr::before{left:auto; right:0;}
  .crop-corner.tr::after{left:auto; right:0;}
  .crop-corner.bl::before{top:auto; bottom:0;}
  .crop-corner.bl::after{top:auto; bottom:0;}
  .crop-corner.br::before{top:auto; bottom:0; left:auto; right:0;}
  .crop-corner.br::after{top:auto; bottom:0; left:auto; right:0;}

  .hero-placeholder-label{
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    color:var(--stone);
    font-family:'JetBrains Mono'; font-size:.75rem; letter-spacing:.08em;
    text-transform:uppercase;
  }
  .hero-scrim{
    position:absolute; inset:0;
    background:linear-gradient(0deg, rgba(23,20,15,.82) 0%, rgba(23,20,15,0) 55%);
  }
  .hero-content{
    position:absolute; left:0; right:0; bottom:0;
    padding:clamp(1.2rem,3vw,2.6rem);
    color:#F6F4EC;
    z-index:2;
  }
  .hero-content .eyebrow{color:#CFC9B4; margin-bottom:.6rem;}
  .hero-content h1{
    font-family:'Space Grotesk';
    font-weight:700;
    font-size:clamp(2rem, 5.5vw, 4rem);
    line-height:.98;
    letter-spacing:-.02em;
    max-width:16ch;
    margin-bottom:1.3rem;
  }
  .btn-primary{
    display:inline-flex; align-items:center; gap:.5rem;
    background:var(--accent); color:var(--accent-ink);
    padding:.85rem 1.4rem;
    font-family:'JetBrains Mono'; font-size:.78rem; letter-spacing:.06em;
    text-transform:uppercase;
    transition:transform .15s ease, background .15s ease;
  }
  .btn-primary:hover{background:#1D2CD8; transform:translateY(-1px);}
  .btn-ghost{
    display:inline-flex; align-items:center; gap:.5rem;
    border:1px solid var(--ink); color:var(--ink);
    padding:.7rem 1.2rem;
    font-family:'JetBrains Mono'; font-size:.75rem; letter-spacing:.05em;
    text-transform:uppercase;
    background:var(--surface);
  }
  .btn-ghost:hover{background:var(--ink); color:var(--paper);}

  /* ===== FILTERS ===== */
  .filters-section{
    padding:2.4rem 0 1.2rem;
  }
  .filters-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom:1rem; flex-wrap:wrap; gap:.5rem;
  }
  .filters-head h2{font-family:'Space Grotesk'; font-weight:700; font-size:1.3rem;}
  .filter-row{
    display:flex; flex-wrap:wrap; gap:.55rem;
    padding-bottom:.3rem;
  }
  .filter-chip{
    font-family:'JetBrains Mono'; font-size:.74rem; letter-spacing:.03em;
    padding:.5rem .9rem;
    border:1px solid var(--line);
    background:var(--surface);
    color:var(--stone);
    transition:all .15s ease;
    white-space:nowrap;
  }
  .filter-chip:hover{border-color:var(--ink); color:var(--ink);}
  .filter-chip.active{
    background:var(--ink); border-color:var(--ink); color:var(--paper);
  }
  .filter-group-label{
    font-family:'JetBrains Mono'; font-size:.65rem; color:var(--stone);
    align-self:center; margin-right:.2rem; text-transform:uppercase;
  }

  /* ===== GRID ===== */
  .catalog{padding:1rem 0 3rem;}
  .product-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));
    gap:1.6rem 1.3rem;
  }
  .product-card{
    background:var(--surface);
    border:1px solid var(--line);
    display:flex; flex-direction:column;
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .product-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 24px -14px rgba(23,20,15,.35);
  }
  .product-photo{
    position:relative;
    aspect-ratio:3/4;
    background:repeating-linear-gradient(45deg, #DCD6C4 0 2px, #E9E4D5 2px 22px);
    overflow:hidden;
  }
  .product-photo .crop-corner{width:14px; height:14px;}
  .product-photo .crop-corner.tl,.product-photo .crop-corner.tr{top:8px;}
  .product-photo .crop-corner.bl,.product-photo .crop-corner.br{bottom:8px;}
  .product-photo .crop-corner.tl,.product-photo .crop-corner.bl{left:8px;}
  .product-photo .crop-corner.tr,.product-photo .crop-corner.br{right:8px;}
  .photo-label{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    text-align:center; padding:1rem;
    color:var(--stone); font-family:'JetBrains Mono'; font-size:.68rem;
    letter-spacing:.06em; text-transform:uppercase;
  }
  .field-tag{
    position:absolute; top:10px; left:10px;
    background:var(--ink); color:var(--paper);
    font-family:'JetBrains Mono'; font-size:.6rem; letter-spacing:.05em;
    padding:.25rem .45rem;
    z-index:2;
  }
  .sale-tag{
    position:absolute; top:10px; right:10px;
    background:var(--danger); color:#fff;
    font-family:'JetBrains Mono'; font-size:.62rem;
    padding:.25rem .45rem; z-index:2;
  }
  .quick-add{
    position:absolute; left:10px; right:10px; bottom:10px;
    background:var(--ink); color:var(--paper);
    font-family:'JetBrains Mono'; font-size:.7rem; letter-spacing:.04em;
    text-transform:uppercase;
    padding:.6rem; text-align:center;
    opacity:0; transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease;
  }
  .product-card:hover .quick-add{opacity:1; transform:translateY(0);}

  .product-info{padding:.9rem 1rem 1.1rem; display:flex; flex-direction:column; gap:.35rem; flex:1;}
  .product-cat{font-family:'JetBrains Mono'; font-size:.62rem; color:var(--stone); text-transform:uppercase; letter-spacing:.06em;}
  .product-name{font-family:'Space Grotesk'; font-weight:600; font-size:1rem; line-height:1.25;}
  .price-row{display:flex; align-items:center; gap:.5rem; margin-top:.25rem;}
  .price-now{font-family:'JetBrains Mono'; font-weight:600; font-size:.95rem;}
  .price-old{font-family:'JetBrains Mono'; font-size:.78rem; color:var(--stone); text-decoration:line-through;}

  .empty-state{
    grid-column:1/-1;
    text-align:center; padding:3rem 1rem;
    color:var(--stone); font-family:'JetBrains Mono'; font-size:.8rem;
    border:1px dashed var(--line);
  }

  /* ===== TRUST / LOCATION ===== */
  .trust-section{
    background:var(--ink); color:var(--paper);
    padding:3.2rem 0;
  }
  .trust-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:2.5rem;
  }
  @media (max-width:820px){.trust-grid{grid-template-columns:1fr;}}
  .benefits-list{display:flex; flex-direction:column; gap:1.4rem;}
  .benefit{display:flex; gap:.9rem; align-items:flex-start;}
  .benefit .num{
    font-family:'JetBrains Mono'; font-size:.7rem; color:var(--accent);
    border:1px solid rgba(246,244,236,.3); width:30px; height:30px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .benefit h3{font-family:'Space Grotesk'; font-size:1rem; margin-bottom:.2rem;}
  .benefit p{font-size:.85rem; color:#CFC9B4;}

  .location-card{border:1px solid rgba(246,244,236,.25);}
  .map-frame{width:100%; aspect-ratio:16/10; border:none; filter:grayscale(.3) contrast(1.05);}
  .location-details{padding:1.1rem 1.2rem;}
  .location-details h3{font-family:'Space Grotesk'; font-size:1rem; margin-bottom:.5rem;}
  .location-details p{font-size:.85rem; color:#CFC9B4; line-height:1.6;}
  .location-details .mono{color:var(--accent); display:block; margin-top:.5rem;}

  /* ===== FOOTER ===== */
  footer.site-footer{
    background:#100E0A; color:#CFC9B4; padding:3rem 0 1.5rem;
  }
  .footer-grid{
    display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:2rem;
    padding-bottom:2.4rem; border-bottom:1px solid rgba(246,244,236,.12);
  }
  @media (max-width:760px){.footer-grid{grid-template-columns:1fr 1fr;}}
  .footer-brand .logo{color:#F6F4EC; margin-bottom:.7rem;}
  .footer-brand p{font-size:.82rem; max-width:32ch; color:#9C9683;}
  .footer-col h4{
    font-family:'JetBrains Mono'; font-size:.68rem; text-transform:uppercase;
    letter-spacing:.08em; color:#F6F4EC; margin-bottom:.9rem;
  }
  .footer-col ul{display:flex; flex-direction:column; gap:.55rem;}
  .footer-col a{font-size:.85rem; transition:color .15s ease;}
  .footer-col a:hover{color:#F6F4EC;}
  .footer-bottom{
    display:flex; justify-content:space-between; align-items:center;
    padding-top:1.4rem; font-size:.75rem; color:#7E7862; flex-wrap:wrap; gap:.6rem;
  }
  .footer-bottom .socials{display:flex; gap:1rem;}

  /* ===== WHATSAPP FLOAT ===== */
  .wa-float{
    position:fixed; right:1.3rem; bottom:1.3rem; z-index:60;
    width:54px; height:54px; border-radius:50%;
    background:#25D366; display:flex; align-items:center; justify-content:center;
    box-shadow:0 8px 20px -6px rgba(0,0,0,.4);
    transition:transform .15s ease;
  }
  .wa-float:hover{transform:scale(1.06);}
  .wa-float svg{width:26px; height:26px; fill:#fff;}

  /* ===== CART DRAWER ===== */
  .cart-drawer{
    position:fixed; top:0; right:0; height:100vh; width:min(92vw,380px);
    background:var(--paper); border-left:1px solid var(--line);
    z-index:80; transform:translateX(100%); transition:transform .25s ease;
    display:flex; flex-direction:column;
  }
  .cart-drawer.open{transform:translateX(0);}
  .cart-head{
    display:flex; justify-content:space-between; align-items:center;
    padding:1.1rem 1.2rem; border-bottom:1px solid var(--line);
  }
  .cart-head h3{font-family:'Space Grotesk'; font-size:1rem;}
  .cart-items{flex:1; overflow-y:auto; padding:1rem 1.2rem; display:flex; flex-direction:column; gap:1rem;}
  .cart-item{display:flex; gap:.8rem; border-bottom:1px solid var(--line); padding-bottom:1rem;}
  .cart-item .thumb{
    width:56px; height:70px; background:repeating-linear-gradient(45deg,#DCD6C4 0 2px,#E9E4D5 2px 18px);
    flex-shrink:0;
  }
  .cart-item .ci-info{flex:1;}
  .cart-item .ci-info .name{font-family:'Space Grotesk'; font-size:.88rem;}
  .cart-item .ci-info .meta{font-family:'JetBrains Mono'; font-size:.68rem; color:var(--stone); margin-top:.2rem;}
  .cart-item .remove-btn{font-family:'JetBrains Mono'; font-size:.68rem; color:var(--danger); margin-top:.4rem;}
  .cart-empty{color:var(--stone); font-family:'JetBrains Mono'; font-size:.78rem; text-align:center; padding:2rem 0;}
  .cart-foot{padding:1.1rem 1.2rem; border-top:1px solid var(--line);}
  .cart-total-row{display:flex; justify-content:space-between; font-family:'JetBrains Mono'; font-size:.9rem; margin-bottom:.8rem;}
  .overlay{
    position:fixed; inset:0; background:rgba(23,20,15,.5); z-index:70;
    opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .overlay.show{opacity:1; pointer-events:auto;}

  /* ===== MODAL ===== */
  .modal{
    position:fixed; inset:0; z-index:90;
    display:flex; align-items:center; justify-content:center;
    padding:1.2rem;
    opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .modal.show{opacity:1; pointer-events:auto;}
  .modal-panel{
    background:var(--surface); border:1px solid var(--line);
    max-width:920px; width:100%; max-height:88vh; overflow:auto;
    display:grid; grid-template-columns:1fr 1fr;
  }
  @media (max-width:700px){.modal-panel{grid-template-columns:1fr;}}
  .modal-gallery{border-right:1px solid var(--line); padding:1rem;}
  @media (max-width:700px){.modal-gallery{border-right:none; border-bottom:1px solid var(--line);}}
  .modal-main-photo{
    aspect-ratio:3/4; background:repeating-linear-gradient(45deg,#DCD6C4 0 2px,#E9E4D5 2px 24px);
    position:relative; margin-bottom:.6rem;
  }
  .modal-thumbs{display:flex; gap:.5rem;}
  .modal-thumb{
    width:56px; height:70px; border:1px solid var(--line); cursor:pointer;
    background:repeating-linear-gradient(45deg,#DCD6C4 0 2px,#E9E4D5 2px 14px);
    display:flex; align-items:center; justify-content:center;
    font-family:'JetBrains Mono'; font-size:.55rem; color:var(--stone);
  }
  .modal-thumb.active{border-color:var(--ink); border-width:2px;}
  .modal-details{padding:1.4rem;}
  .modal-close{
    position:absolute; top:.9rem; right:.9rem; z-index:2;
    width:32px; height:32px; background:var(--paper); border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
  }
  .modal-details .product-cat{margin-bottom:.4rem;}
  .modal-details h2{font-family:'Space Grotesk'; font-size:1.5rem; margin-bottom:.2rem;}
  .modal-details .sku{font-family:'JetBrains Mono'; font-size:.68rem; color:var(--stone); margin-bottom:.9rem;}
  .modal-price-row{display:flex; align-items:center; gap:.6rem; margin-bottom:.3rem;}
  .modal-price-row .price-now{font-size:1.3rem;}
  .installments{font-family:'JetBrains Mono'; font-size:.72rem; color:var(--stone); margin-bottom:1.1rem;}
  .modal-section{margin-bottom:1.1rem;}
  .modal-section h4{
    font-family:'JetBrains Mono'; font-size:.65rem; text-transform:uppercase;
    letter-spacing:.06em; color:var(--stone); margin-bottom:.4rem;
  }
  .modal-section p{font-size:.85rem; line-height:1.55;}
  .size-options{display:flex; gap:.5rem; flex-wrap:wrap;}
  .size-chip{
    width:38px; height:38px; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-family:'JetBrains Mono'; font-size:.72rem;
  }
  .size-chip:hover{border-color:var(--ink);}
  .size-chip.selected{background:var(--ink); color:var(--paper); border-color:var(--ink);}
  .color-options{display:flex; gap:.5rem;}
  .color-chip{
    width:26px; height:26px; border-radius:50%; border:1px solid var(--line);
    cursor:pointer;
  }
  .color-chip.selected{outline:2px solid var(--ink); outline-offset:2px;}
  .stock-note{font-family:'JetBrains Mono'; font-size:.72rem; color:var(--stone); margin-bottom:1rem;}
  .modal-add-btn{width:100%; justify-content:center; margin-top:.4rem;}

  .toast{
    position:fixed; bottom:1.3rem; left:50%; transform:translate(-50%,20px);
    background:var(--ink); color:var(--paper);
    font-family:'JetBrains Mono'; font-size:.78rem;
    padding:.8rem 1.3rem; z-index:100;
    opacity:0; transition:opacity .2s ease, transform .2s ease;
    pointer-events:none;
  }
  .toast.show{opacity:1; transform:translate(-50%,0);}

  section > .wrap > .section-eyebrow{margin-bottom:.4rem;}
</style>
</head>
<body>

<!-- ===================== HEADER ===================== -->
<header class="site-header">
  <div class="wrap header-row">
    <div class="logo">MARCA<span>.</span></div>

    <nav class="main-nav" id="mainNav">
      <a href="#" class="active">Hombre</a>
      <a href="#">Mujer</a>
      <a href="#" class="offers">Ofertas</a>
    </nav>

    <div class="header-actions">
      <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--stone)" stroke-width="2" width="15" height="15"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" placeholder="Buscar producto…" aria-label="Buscar producto">
      </div>
      <button class="icon-btn" aria-label="Perfil / Contacto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
      </button>
      <button class="icon-btn" id="cartToggle" aria-label="Carrito de compras">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L4 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        <span class="cart-count" id="cartCount">0</span>
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
