</section>

<!-- ===================== FOOTER ===================== -->
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo-center serif">[Nombre del showroom]</div>
        <p>[Poner aquí una breve descripción de marca, tono íntimo, una o dos líneas]</p>
        <div class="socials">
          <a href="#">Instagram</a>
          <a href="#">TikTok</a>
          <a href="#">Pinterest</a>
        </div>
      </div>

      <div class="insta-feed">
        <h4>@[usuario_instagram]</h4>
        <div class="insta-grid">
          <div class="insta-tile"></div><div class="insta-tile"></div><div class="insta-tile"></div>
          <div class="insta-tile"></div><div class="insta-tile"></div><div class="insta-tile"></div>
        </div>
      </div>

      <div class="newsletter">
        <h4>Newsletter</h4>
        <p class="lead">Sumate y llevate [poner % de descuento] en tu primera compra.</p>
        <form class="newsletter-form" id="newsletterForm">
          <input type="email" placeholder="tu@email.com" required aria-label="Email para newsletter">
          <button type="submit">Unirme →</button>
