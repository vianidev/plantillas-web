  </button>
  <a href="#destacados">Colecciones</a>
  <a href="#marca">Editorial</a>
  <a href="#showroom">Contacto</a>
</nav>

<!-- ===================== HERO SLIDER ===================== -->
<section class="hero-slider" id="heroSlider">
