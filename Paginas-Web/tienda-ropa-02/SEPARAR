<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[NOMBRE DEL SHOWROOM] — Lookbook</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --noir:#15120E;
    --panel:#1E1A14;
    --panel-2:#26211A;
    --ivory:#F3EEE3;
    --stone:#B7AC98;
    --brass:#B4854C;
    --wine:#7A3630;
    --hair:rgba(243,238,227,.14);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--noir); color:var(--ivory);
    font-family:'Work Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{display:block; max-width:100%;}
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; background:none; border:none; cursor:pointer; color:inherit;}
  ul{list-style:none;}

  .serif{font-family:'Fraunces', serif;}
  .mono{font-family:'IBM Plex Mono', monospace;}

  a:focus-visible, button:focus-visible, input:focus-visible{outline:2px solid var(--brass); outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){ *{animation-duration:.01ms !important; transition-duration:.01ms !important;} }

  .wrap{max-width:1320px; margin:0 auto; padding:0 clamp(1.1rem,4vw,3rem);}
  .eyebrow{
    font-family:'IBM Plex Mono'; font-size:.68rem; letter-spacing:.16em;
    text-transform:uppercase; color:var(--brass);
  }
  .section-pad{padding:clamp(4rem,9vw,7rem) 0;}
  .fig-caption{
    font-family:'IBM Plex Mono'; font-size:.68rem; color:var(--stone);
    letter-spacing:.05em; margin-top:.7rem; display:flex; gap:.6rem;
  }
  .fig-caption span:first-child{color:var(--brass);}

  /* ===================== HEADER ===================== */
  header.site-header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    padding:1.4rem 0;
    transition:background .3s ease, padding .3s ease, border-color .3s ease;
    border-bottom:1px solid transparent;
  }
  header.site-header.scrolled{
    background:rgba(21,18,14,.92);
    backdrop-filter:blur(10px);
    padding:.9rem 0;
    border-bottom-color:var(--hair);
  }
  .header-row{
    display:grid; grid-template-columns:1fr auto 1fr;
    align-items:center; gap:1rem;
  }
  .header-left{display:flex; align-items:center; gap:.9rem;}
  .hamburger{
    width:38px; height:38px; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:5px;
    border:1px solid var(--hair);
  }
  .hamburger span{width:15px; height:1px; background:var(--ivory);}
  .logo-center{
    text-align:center; font-family:'Fraunces'; font-weight:600;
    font-size:1.3rem; letter-spacing:.02em;
  }
  .header-right{display:flex; align-items:center; gap:.8rem; justify-content:flex-end;}
  .icon-btn{
    position:relative; width:38px; height:38px;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--hair);
  }
  .icon-btn svg{width:15px; height:15px; stroke:var(--ivory);}
  .bag-count{
    position:absolute; top:-6px; right:-6px;
    background:var(--brass); color:var(--noir);
    font-family:'IBM Plex Mono'; font-size:.6rem;
    width:16px; height:16px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }
  .header-nav-inline{display:none; gap:1.7rem; font-size:.82rem;}
  @media (min-width:920px){ .header-nav-inline{display:flex;} }

  /* Overlay de navegación */
  .nav-overlay{
    position:fixed; inset:0; z-index:110;
    background:var(--noir);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:1.6rem;
    opacity:0; pointer-events:none; transition:opacity .3s ease;
  }
  .nav-overlay.show{opacity:1; pointer-events:auto;}
  .nav-overlay a{font-family:'Fraunces'; font-size:clamp(2rem,6vw,3.2rem); font-weight:500;}
  .nav-overlay a:hover{color:var(--brass);}
  .nav-close{position:absolute; top:1.6rem; right:clamp(1.1rem,4vw,3rem); width:38px; height:38px; border:1px solid var(--hair); display:flex; align-items:center; justify-content:center;}

  /* ===================== HERO SLIDER ===================== */
  .hero-slider{position:relative; height:100vh; min-height:560px; overflow:hidden;}
  .slide{
    position:absolute; inset:0;
    opacity:0; transition:opacity 1s ease;
  }
  .slide.active{opacity:1;}
  .slide-frame{
    position:absolute; inset:0;
    background:var(--frame-bg, repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 34px));
  }
  .slide:nth-child(1) .slide-frame{--frame-bg:repeating-linear-gradient(135deg,#221D16 0 2px,#2C261C 2px 34px);}
  .slide:nth-child(2) .slide-frame{--frame-bg:repeating-linear-gradient(115deg,#241A16 0 2px,#2E2119 2px 34px);}
  .slide:nth-child(3) .slide-frame{--frame-bg:repeating-linear-gradient(155deg,#1E1D16 0 2px,#28261C 2px 34px);}
  .slide-scrim{position:absolute; inset:0; background:linear-gradient(0deg, rgba(21,18,14,.9) 0%, rgba(21,18,14,.15) 45%, rgba(21,18,14,.35) 100%);}
  .slide-label{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    color:var(--stone); font-family:'IBM Plex Mono'; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
  }
  .hero-copy{
    position:absolute; left:0; right:0; bottom:14%; text-align:center; padding:0 1.2rem; z-index:3;
  }
  .hero-copy .eyebrow{justify-content:center; display:flex; margin-bottom:1rem;}
  .hero-copy h1{
    font-family:'Fraunces'; font-weight:500;
    font-size:clamp(2.4rem, 7vw, 5.4rem); line-height:1.02; letter-spacing:-.01em;
    max-width:18ch; margin:0 auto 1.6rem;
  }
  .hero-copy h1 em{font-style:italic; color:var(--brass); font-weight:500;}
  .hero-cta{display:inline-flex; gap:.6rem; align-items:center; border:1px solid var(--ivory); padding:.85rem 1.6rem; font-family:'IBM Plex Mono'; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; transition:background .2s ease,color .2s ease;}
  .hero-cta:hover{background:var(--ivory); color:var(--noir);}
  .slider-dots{position:absolute; bottom:2.4rem; left:50%; transform:translateX(-50%); display:flex; gap:.6rem; z-index:3;}
  .slider-dots button{width:26px; height:2px; background:rgba(243,238,227,.35); transition:background .2s ease;}
  .slider-dots button.active{background:var(--ivory);}
  .scroll-cue{
    position:absolute; bottom:2.4rem; right:clamp(1.1rem,4vw,3rem); z-index:3;
    writing-mode:vertical-rl; font-family:'IBM Plex Mono'; font-size:.65rem;
    letter-spacing:.15em; color:var(--stone); display:flex; align-items:center; gap:.6rem;
  }
  .scroll-cue::after{content:""; width:1px; height:34px; background:var(--stone);}

  /* ===================== DESTACADOS (grid asimétrico) ===================== */
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    gap:1.5rem; flex-wrap:wrap; margin-bottom:2.2rem;
  }
  .section-head h2{font-family:'Fraunces'; font-weight:500; font-size:clamp(1.8rem,3.4vw,2.6rem);}
  .collection-filters{display:flex; flex-wrap:wrap; gap:.5rem;}
  .filter-chip{
    font-family:'IBM Plex Mono'; font-size:.7rem; letter-spacing:.03em;
    padding:.5rem .9rem; border:1px solid var(--hair); color:var(--stone);
    transition:all .15s ease;
  }
  .filter-chip:hover{border-color:var(--brass); color:var(--ivory);}
  .filter-chip.active{background:var(--brass); border-color:var(--brass); color:var(--noir);}

  .looks-grid{
    display:grid;
    grid-template-columns:repeat(6, 1fr);
    grid-auto-rows:220px;
    grid-auto-flow:dense;
    gap:1.1rem;
  }
  .look-card{
    position:relative; overflow:hidden; grid-column:span 3; grid-row:span 2;
    border:1px solid var(--hair);
  }
  .look-card.size-lg{grid-column:span 4; grid-row:span 3;}
  .look-card.size-sm{grid-column:span 2; grid-row:span 2;}
  @media (max-width:900px){
    .looks-grid{grid-template-columns:repeat(2,1fr); grid-auto-rows:260px;}
    .look-card, .look-card.size-lg, .look-card.size-sm{grid-column:span 2; grid-row:span 2;}
  }
  .look-photo{
    position:absolute; inset:0;
    background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 30px);
    display:flex; align-items:center; justify-content:center;
    transition:opacity .5s ease;
  }
  .look-photo.model{opacity:0; background:repeating-linear-gradient(45deg,#241E17 0 2px,#2E271C 2px 24px);}
  .look-card:hover .look-photo.model{opacity:1;}
  .look-photo .lbl{color:var(--stone); font-family:'IBM Plex Mono'; font-size:.65rem; letter-spacing:.08em; text-transform:uppercase; text-align:center; padding:1rem;}
  .look-tag{
    position:absolute; top:.9rem; left:.9rem; z-index:2;
    font-family:'IBM Plex Mono'; font-size:.62rem; letter-spacing:.05em;
    color:var(--stone); background:rgba(21,18,14,.55); padding:.3rem .5rem;
  }
  .look-info{
    position:absolute; left:0; right:0; bottom:0; z-index:2;
    padding:1rem 1.1rem 1.1rem;
    background:linear-gradient(0deg, rgba(21,18,14,.92) 10%, rgba(21,18,14,0) 100%);
  }
  .look-info h3{font-family:'Fraunces'; font-style:italic; font-weight:500; font-size:1.15rem; margin-bottom:.5rem;}
  .look-price{
    font-family:'IBM Plex Mono'; font-size:.75rem; color:var(--brass);
    opacity:0; transform:translateY(6px);
    transition:opacity .2s ease, transform .2s ease;
  }
  .look-card:hover .look-price{opacity:1; transform:translateY(0);}

  /* ===================== SOBRE LA MARCA ===================== */
  .about-grid{display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,6vw,5rem); align-items:center;}
  @media (max-width:860px){.about-grid{grid-template-columns:1fr;}}
  .about-text .eyebrow{margin-bottom:1.1rem;}
  blockquote.pull-quote{
    font-family:'Fraunces'; font-style:italic; font-weight:500;
    font-size:clamp(1.5rem,3vw,2.1rem); line-height:1.3;
    margin-bottom:1.4rem;
  }
  .about-text p.body-copy{color:var(--stone); font-size:.92rem; line-height:1.7; max-width:44ch;}
  .about-photo-frame{
    border:1px solid var(--brass); padding:.5rem;
  }
  .about-photo{
    aspect-ratio:4/5;
    background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 32px);
    display:flex; align-items:center; justify-content:center;
    color:var(--stone); font-family:'IBM Plex Mono'; font-size:.68rem; text-align:center; padding:1rem;
    text-transform:uppercase; letter-spacing:.06em;
  }

  /* ===================== SHOP THE LOOK ===================== */
  .stl-photo-wrap{position:relative; border:1px solid var(--hair);}
  .stl-photo{
    aspect-ratio:16/10;
    background:repeating-linear-gradient(115deg,#221D16 0 2px,#2C261C 2px 36px);
    display:flex; align-items:center; justify-content:center;
    color:var(--stone); font-family:'IBM Plex Mono'; font-size:.72rem; text-transform:uppercase; letter-spacing:.08em;
  }
  .hotspot{
    position:absolute; width:26px; height:26px;
    border:1px solid var(--ivory); border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono'; font-size:.68rem;
    background:rgba(21,18,14,.55);
  }
  .hotspot::before{
    content:""; position:absolute; inset:-8px; border:1px solid var(--brass); border-radius:50%;
    animation:pulse 2.2s ease-out infinite;
  }
  @keyframes pulse{
    0%{transform:scale(.7); opacity:.9;}
    100%{transform:scale(1.6); opacity:0;}
  }
  .hotspot:hover, .hotspot.open{background:var(--brass); color:var(--noir); border-color:var(--brass);}
  .hotspot-card{
    position:absolute; width:210px;
    background:var(--panel); border:1px solid var(--hair);
    padding:.9rem; z-index:5;
    opacity:0; pointer-events:none; transform:translateY(6px);
    transition:opacity .18s ease, transform .18s ease;
  }
  .hotspot-card.show{opacity:1; pointer-events:auto; transform:translateY(0);}
  .hotspot-card .name{font-family:'Fraunces'; font-style:italic; font-size:1rem; margin-bottom:.3rem;}
  .hotspot-card .price{font-family:'IBM Plex Mono'; font-size:.72rem; color:var(--brass); margin-bottom:.6rem;}
  .hotspot-card button{font-family:'IBM Plex Mono'; font-size:.66rem; letter-spacing:.05em; text-transform:uppercase; border-bottom:1px solid var(--brass); padding-bottom:.15rem;}

  /* ===================== SHOWROOM ===================== */
  .showroom-gallery{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2.2rem;
  }
  @media (max-width:760px){.showroom-gallery{grid-template-columns:1fr 1fr;}}
  .showroom-photo{
    aspect-ratio:3/4;
    background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 28px);
    display:flex; align-items:center; justify-content:center;
    color:var(--stone); font-family:'IBM Plex Mono'; font-size:.62rem; text-align:center; padding:.8rem;
    text-transform:uppercase; letter-spacing:.05em; border:1px solid var(--hair);
  }
  .showroom-info{display:grid; grid-template-columns:1.1fr 1fr; gap:2.5rem; align-items:start;}
  @media (max-width:820px){.showroom-info{grid-template-columns:1fr;}}
  .showroom-details p{color:var(--stone); font-size:.9rem; line-height:1.7; margin-bottom:.5rem;}
  .showroom-details .mono{color:var(--brass); display:inline-block; margin-top:.4rem;}
  .map-frame{width:100%; aspect-ratio:16/11; border:1px solid var(--hair); filter:invert(.92) grayscale(.4) contrast(1.05);}

  /* ===================== FOOTER ===================== */
  footer.site-footer{border-top:1px solid var(--hair); padding:4rem 0 1.6rem;}
  .footer-top{display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:2.5rem; padding-bottom:3rem; border-bottom:1px solid var(--hair);}
  @media (max-width:860px){.footer-top{grid-template-columns:1fr; gap:2.4rem;}}
  .footer-brand .logo-center{text-align:left; margin-bottom:.8rem;}
  .footer-brand p{color:var(--stone); font-size:.85rem; max-width:34ch; margin-bottom:1.2rem;}
  .footer-brand .socials{display:flex; gap:1rem; font-family:'IBM Plex Mono'; font-size:.75rem;}
  .footer-brand .socials a:hover{color:var(--brass);}

  .insta-feed h4, .newsletter h4{
    font-family:'IBM Plex Mono'; font-size:.68rem; text-transform:uppercase; letter-spacing:.08em;
    color:var(--stone); margin-bottom:1rem;
  }
  .insta-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:.5rem;}
  .insta-tile{
    aspect-ratio:1/1; position:relative; overflow:hidden;
    background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 18px);
  }
  .insta-tile::after{
    content:"♡"; position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    color:var(--ivory); font-size:1.1rem; opacity:0; background:rgba(21,18,14,.5); transition:opacity .2s ease;
  }
  .insta-tile:hover::after{opacity:1;}

  .newsletter p.lead{color:var(--stone); font-size:.85rem; margin-bottom:1rem; line-height:1.6;}
  .newsletter-form{display:flex; border-bottom:1px solid var(--hair); padding-bottom:.6rem;}
  .newsletter-form input{
    flex:1; background:none; border:none; outline:none; color:var(--ivory);
    font-family:'Work Sans'; font-size:.85rem; padding:.4rem 0;
  }
  .newsletter-form input::placeholder{color:var(--stone);}
  .newsletter-form button{font-family:'IBM Plex Mono'; font-size:.68rem; letter-spacing:.05em; text-transform:uppercase; color:var(--brass);}
  .newsletter-msg{font-family:'IBM Plex Mono'; font-size:.72rem; color:var(--brass); margin-top:.7rem; min-height:1em;}

  .footer-bottom{display:flex; justify-content:space-between; flex-wrap:wrap; gap:.6rem; padding-top:1.4rem; font-family:'IBM Plex Mono'; font-size:.68rem; color:var(--stone);}

  /* ===================== QUICK VIEW MODAL ===================== */
  .overlay{position:fixed; inset:0; background:rgba(21,18,14,.75); z-index:120; opacity:0; pointer-events:none; transition:opacity .2s ease;}
  .overlay.show{opacity:1; pointer-events:auto;}
  .qv-modal{
    position:fixed; inset:0; z-index:130; display:flex; align-items:center; justify-content:center;
    padding:1.2rem; opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .qv-modal.show{opacity:1; pointer-events:auto;}
  .qv-panel{
    background:var(--panel); border:1px solid var(--hair);
    max-width:940px; width:100%; max-height:88vh; overflow:auto;
    display:grid; grid-template-columns:1.1fr 1fr; position:relative;
  }
  @media (max-width:720px){.qv-panel{grid-template-columns:1fr;}}
  .qv-gallery{border-right:1px solid var(--hair); padding:1.2rem;}
  @media (max-width:720px){.qv-gallery{border-right:none; border-bottom:1px solid var(--hair);}}
  .qv-main-photo{
    aspect-ratio:4/5; background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 30px);
    display:flex; align-items:center; justify-content:center; color:var(--stone);
    font-family:'IBM Plex Mono'; font-size:.68rem; text-align:center; text-transform:uppercase; margin-bottom:.7rem;
  }
  .qv-thumbs{display:flex; gap:.5rem;}
  .qv-thumb{
    width:58px; height:72px; border:1px solid var(--hair); cursor:pointer;
    background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 14px);
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono'; font-size:.55rem; color:var(--stone);
  }
  .qv-thumb.active{border-color:var(--brass); border-width:2px;}
  .qv-details{padding:1.6rem;}
  .qv-close{position:absolute; top:1rem; right:1rem; z-index:2; width:32px; height:32px; background:var(--noir); border:1px solid var(--hair); display:flex; align-items:center; justify-content:center;}
  .qv-details .eyebrow{margin-bottom:.5rem;}
  .qv-details h2{font-family:'Fraunces'; font-style:italic; font-weight:500; font-size:1.7rem; margin-bottom:.9rem;}
  .qv-price{font-family:'IBM Plex Mono'; font-size:1rem; color:var(--brass); margin-bottom:1.2rem;}
  .qv-section{margin-bottom:1.1rem;}
  .qv-section h4{font-family:'IBM Plex Mono'; font-size:.63rem; text-transform:uppercase; letter-spacing:.06em; color:var(--stone); margin-bottom:.4rem;}
  .qv-section p{font-size:.86rem; line-height:1.6; color:var(--ivory);}
  .qv-sizes{display:flex; gap:.5rem; flex-wrap:wrap;}
  .qv-size-chip{width:38px; height:38px; border:1px solid var(--hair); display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono'; font-size:.7rem;}
  .qv-size-chip:hover{border-color:var(--brass);}
  .qv-size-chip.selected{background:var(--brass); color:var(--noir); border-color:var(--brass);}
  .qv-colors{display:flex; gap:.5rem;}
  .qv-color{width:24px; height:24px; border-radius:50%; border:1px solid var(--hair); cursor:pointer;}
  .qv-color.selected{outline:2px solid var(--brass); outline-offset:2px;}
  .qv-add-btn{
    width:100%; text-align:center; margin-top:.4rem; padding:.9rem;
    border:1px solid var(--ivory); font-family:'IBM Plex Mono'; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase;
    transition:background .2s ease, color .2s ease;
  }
  .qv-add-btn:hover{background:var(--ivory); color:var(--noir);}

  .toast{
    position:fixed; bottom:1.3rem; left:50%; transform:translate(-50%,20px);
    background:var(--brass); color:var(--noir); font-family:'IBM Plex Mono'; font-size:.75rem;
    padding:.75rem 1.2rem; z-index:140; opacity:0; transition:opacity .2s ease, transform .2s ease; pointer-events:none;
  }
  .toast.show{opacity:1; transform:translate(-50%,0);}

  /* ===================== BOLSA (drawer minimalista) ===================== */
  .bag-drawer{
    position:fixed; top:0; right:0; height:100vh; width:min(92vw,380px);
    background:var(--panel); border-left:1px solid var(--hair);
    z-index:125; transform:translateX(100%); transition:transform .25s ease; display:flex; flex-direction:column;
  }
  .bag-drawer.open{transform:translateX(0);}
  .bag-head{display:flex; justify-content:space-between; align-items:center; padding:1.2rem; border-bottom:1px solid var(--hair);}
  .bag-head h3{font-family:'Fraunces'; font-style:italic; font-size:1.05rem;}
  .bag-items{flex:1; overflow-y:auto; padding:1rem 1.2rem; display:flex; flex-direction:column; gap:1rem;}
  .bag-item{display:flex; gap:.8rem; border-bottom:1px solid var(--hair); padding-bottom:1rem;}
  .bag-item .thumb{width:54px; height:68px; background:repeating-linear-gradient(135deg,#221D16 0 2px,#2A241B 2px 16px); flex-shrink:0;}
  .bag-item .bi-name{font-family:'Fraunces'; font-style:italic; font-size:.88rem;}
  .bag-item .bi-meta{font-family:'IBM Plex Mono'; font-size:.65rem; color:var(--stone); margin-top:.2rem;}
  .bag-item .remove-btn{font-family:'IBM Plex Mono'; font-size:.65rem; color:var(--wine); margin-top:.4rem;}
  .bag-empty{color:var(--stone); font-family:'IBM Plex Mono'; font-size:.76rem; text-align:center; padding:2rem 0;}
  .bag-foot{padding:1.1rem 1.2rem; border-top:1px solid var(--hair);}
