<!-- ===================== DESTACADOS ===================== -->
<section class="section-pad" id="destacados">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow" style="margin-bottom:.6rem;">Destacados de la semana</p>
        <h2 class="serif">Total looks, no prendas sueltas</h2>
      </div>
      <div class="collection-filters" id="collectionFilters">
        <button class="filter-chip active" data-coll="todas">Todas</button>
        <button class="filter-chip" data-coll="capsula">Cápsula 01</button>
        <button class="filter-chip" data-coll="otono">Otoño [año]</button>
        <button class="filter-chip" data-coll="total-black">Total Black</button>
